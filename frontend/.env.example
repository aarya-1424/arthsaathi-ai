# Copy to frontend/.env.local and fill in. These two values are PUBLIC (safe in the browser).
# Find them in Supabase: Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for the live site (leave empty locally): the server address on Render, like https://arthsaathi-api.onrender.com
VITE_API_URL=

# Optional: a public contact email shown in the footer and legal pages
VITE_CONTACT_EMAIL=

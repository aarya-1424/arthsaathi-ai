# Copy this file to backend/.env and fill in real values. NEVER commit the real .env file.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Your Supabase project address, like https://xxxx.supabase.co (public, not a secret)
SUPABASE_URL=
# Public key from Supabase > Project Settings > API keys (publishable). Not a secret.
SUPABASE_PUBLISHABLE_KEY=

# Added in later milestones (these ARE secrets):
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER=xai
# XAI_API_KEY=
